# Instagram Graph API (장기 액세스 토큰, 권한: instagram_basic, instagram_content_publish, pages_show_list)
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v21.0

# 캡션 자동 생성 (선택). 없으면 주제 문구를 그대로 캡션으로 사용
ANTHROPIC_API_KEY=

# 영상 생성 방식: local(videos/ 폴더 큐) | command(외부 명령 실행)
VIDEO_PROVIDER=local
# command 방식일 때: {topic} {output} 치환. 예) python gen.py --topic "{topic}" --out "{output}"
VIDEO_COMMAND=
